class_name TrackLoader
## Reads a circuit generated by tools/data/build_*.py (data/tracks/*.json) into a LoadedTrack:
## the TrackData the physics uses plus the race furniture (grid, pit lane, DRS, sectors,
## racing line) and the environment the 3D world is built from.


static func load_track(path: String) -> LoadedTrack:
	var text := FileAccess.get_file_as_string(path)
	assert(not text.is_empty(), "cannot read " + path)
	var j: Dictionary = JSON.parse_string(text)
	var t := LoadedTrack.new()
	t.name = j.get("name", "")
	t.laps = int(j.get("laps", 1))
	t.start_index = int(j.get("start_index", 0))

	var d := TrackData.new()
	d.track_name = t.name
	d.points = _vec2_array(j["points"])
	d.heights = PackedFloat32Array(j.get("heights", []))
	d.width_left = PackedFloat32Array(j["width_left"])
	d.width_right = PackedFloat32Array(j["width_right"])
	d.kerb_left = PackedFloat32Array(j["kerb_left"])
	d.kerb_right = PackedFloat32Array(j["kerb_right"])
	d.kerb_high_left = PackedByteArray(j["kerb_high_left"])
	d.kerb_high_right = PackedByteArray(j["kerb_high_right"])
	d.runoff_left = _surfaces(j["runoff_left"])
	d.runoff_right = _surfaces(j["runoff_right"])
	d.wall_left = PackedFloat32Array(j["wall_left"])
	d.wall_right = PackedFloat32Array(j["wall_right"])
	t.data = d

	t.racing_line = PackedFloat32Array(j.get("racing_line", []))
	for g in j.get("grid", []):
		var slot := LoadedTrack.GridSlot.new()
		slot.position = Vector2(g["x"], g["y"])
		slot.heading = g["heading"]
		slot.index = int(g["index"])
		t.grid.append(slot)
	t.drs_zones = j.get("drs_zones", [])
	t.sectors = PackedFloat32Array(j.get("sectors", []))
	var pit: Dictionary = j.get("pit_lane", {})
	t.pit_lane = _vec2_array(pit.get("points", []))
	t.pit_entry_index = int(pit.get("entry_index", 0))
	t.pit_exit_index = int(pit.get("exit_index", 0))
	t.pit_speed_limit_kmh = float(pit.get("speed_limit_kmh", 100.0))
	t.terrain = j.get("terrain", {})

	var env: Dictionary = j.get("environment", {})
	var e := LoadedTrack.Scenery.new()
	e.lake = _vec2_array(env.get("lake", []))
	e.trees = _vec2_array(env.get("trees", []))
	for b in env.get("buildings", []):
		e.buildings.append({"footprint": _vec2_array(b["footprint"]), "height": float(b["height"])})
	for p in env.get("parks", []):
		e.parks.append({"kind": p.get("kind", ""), "polygon": _vec2_array(p["polygon"])})
	for g in env.get("grandstands", []):
		e.grandstands.append({"polyline": _vec2_array(g["polyline"]), "depth": float(g["depth"])})
	t.environment = e
	return t


static func _vec2_array(rows: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	out.resize(rows.size())
	for i in rows.size():
		out[i] = Vector2(rows[i][0], rows[i][1])
	return out


static func _surfaces(names: Array) -> PackedInt32Array:
	var out := PackedInt32Array()
	out.resize(names.size())
	for i in names.size():
		out[i] = Surface.Type.get(names[i], Surface.Type.GRASS)
	return out
