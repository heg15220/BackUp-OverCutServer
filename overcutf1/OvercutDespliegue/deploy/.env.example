# Domain
DOMAIN=

# MySQL root
MYSQL_ROOT_PASSWORD=

# Application database users
MYSQL_FASTAPI_USER=
MYSQL_FASTAPI_PASSWORD=

MYSQL_OVERCUT_USER=
MYSQL_OVERCUT_PASSWORD=
MYSQL_OVERCUT_DB=overcutdb

MYSQL_F1HUB_USER=
MYSQL_F1HUB_PASSWORD=
MYSQL_F1HUB_DB=f1hubdb

# F1 historical database
MYSQL_F1DB_NAME=f1db

# Java Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
OVERCUT_JWT_SIGNKEY=
OVERCUT_JWT_EXP_MINUTES=1440

# FastAPI DB URI
FASTAPI_DB_URI=mysql+pymysql://${MYSQL_FASTAPI_USER}:${MYSQL_FASTAPI_PASSWORD}@db:3306/${MYSQL_F1DB_NAME}

# Build
NODE_ENV=production

# Timezone
TZ=Europe/Madrid
